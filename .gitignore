# dependencies
/node_modules

# testing
/coverage

# pipeline output that is regenerated on every run. The raw cache, recipes.json, and the
# catalog are committed (SPEC §4); reports are rebuilt from them.
/data/*/reports/
*.tmp

# misc
.DS_Store

# debug
npm-debug.log*

# env files: never commit secrets; .env.example documents the variables
.env*
!.env.example

# typescript
*.tsbuildinfo
