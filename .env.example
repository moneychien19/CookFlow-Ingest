# Copy to .env.local. Never commit .env.local.

# Target database for `ingest:load`: a Neon dev branch, not production.
DATABASE_URL=

# Used by `ingest:normalize`, `ingest:steps`, and the catalog bootstrap to call Claude.
ANTHROPIC_API_KEY=

# Optional: runs the *.db.test.ts tests against this database. They're skipped when it's unset.
# Use a throwaway branch: the tests write to it.
TEST_DATABASE_URL=

# Target for `ingest:load --prod`: CookFlow's production database. The load first checks that
# its schema matches DATABASE_URL's (the dev branch) exactly, and stops if anything differs.
PROD_DATABASE_URL=
